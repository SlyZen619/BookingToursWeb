@model BookingToursWeb.Models.Location

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUserId = ViewBag.CurrentUserId as int?;
    var hasUserReviewed = ViewBag.HasUserReviewed as bool? ?? false;
}

<div class="container py-5">
    <h1 class="text-center mb-4">@Model.Name</h1>

    <hr />

    @* HIỂN THỊ THÔNG BÁO LỖI HOẶC THÀNH CÔNG TỪ TEMPATA *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="successAlert" class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="errorAlert" class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }
    @* KẾT THÚC PHẦN THÔNG BÁO *@

    <div class="row">
        <div class="col-md-8 offset-md-2">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded mb-4" alt="@Model.Name" style="max-height: 400px; width: 100%; object-fit: cover;">
            }
            else
            {
                <img src="/images/placeholder.jpg" class="img-fluid rounded mb-4" alt="No Image" style="max-height: 400px; width: 100%; object-fit: cover;">
            }

            <h3 class="mt-4">Thông tin chi tiết</h3>
            @if (!string.IsNullOrEmpty(Model.Information))
            {
                <div class="card card-body shadow-sm mb-4">
                    @Html.Raw(Model.Information)
                </div>
            }
            else
            {
                <p>Thông tin chi tiết cho địa điểm này đang được cập nhật.</p>
            }

            <h3 class="mt-4">Thông tin khác</h3>
            <div class="card shadow-sm mb-4">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <strong><i class="fas fa-map-marker-alt"></i> Địa chỉ:</strong>
                        <span>@Model.Address</span>
                    </li>
                    @if (Model.TicketPrice.HasValue)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong><i class="fas fa-money-bill-wave"></i> Giá vé ước tính:</strong>
                            <span>@Model.TicketPrice.Value.ToString("N0") VNĐ</span>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <strong><i class="far fa-clock"></i> Giờ mở cửa:</strong>
                        <span>@Model.OpeningHours</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <strong><i class="fas fa-phone-alt"></i> Liên hệ:</strong>
                        <span>@Model.ContactInfo</span>
                    </li>
                </ul>
            </div>

            <div class="text-center mt-4">
                @if (ViewBag.LocationIsActive)
                {
                    <a asp-controller="Home" asp-action="Booking" asp-route-locationId="@Model.Id" class="btn btn-primary btn-md">Đặt lịch tham quan</a>
                }
                else
                {
                    <button class="btn btn-danger btn-md" disabled>Không hoạt động</button>
                }
                <a asp-controller="Home" asp-action="PanoramaPointsForLocation" asp-route-locationId="@Model.Id" class="btn btn-info btn-md ml-2">Xem toàn cảnh</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-md ml-2">Quay lại trang chủ</a>
            </div>

            <h3 class="mt-5">Đánh giá của khách hàng</h3>
            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="list-group mb-4">
                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="list-group-item list-group-item-action flex-column align-items-start">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">@review.User?.Username</h5>
                                <small>@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small> 
                            </div>
                            <p class="mb-1">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <i class="fas fa-star text-warning"></i>
                                }
                                @for (int i = review.Rating; i < 5; i++)
                                {
                                    <i class="far fa-star text-warning"></i>
                                }
                            </p>
                            <p class="mb-1">@review.Comment</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>Chưa có đánh giá nào cho địa điểm này. Hãy là người đầu tiên đánh giá!</p>
            }

            @if (currentUserId != null && !hasUserReviewed)
            {
                <h4 class="mt-4">Gửi đánh giá của bạn</h4>
                <div class="card shadow-sm p-4 mb-5">
                    <form asp-action="AddReview" method="post">
                        <input type="hidden" name="LocationId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">Đánh giá sao:</label>
                            <div id="starRating" class="star-rating d-inline-block">
                                <i class="far fa-star" data-rating="1"></i>
                                <i class="far fa-star" data-rating="2"></i>
                                <i class="far fa-star" data-rating="3"></i>
                                <i class="far fa-star" data-rating="4"></i>
                                <i class="far fa-star" data-rating="5"></i>
                            </div>
                            <input type="hidden" id="Rating" name="Rating" value="" required />
                            <span class="text-danger" id="ratingValidationMessage"></span>
                        </div>
                        <div class="mb-3">
                            <label for="Comment" class="form-label">Bình luận (tùy chọn):</label>
                            <textarea class="form-control" id="Comment" name="Comment" rows="4" maxlength="2000"></textarea>
                            <span class="text-danger" id="commentValidationMessage"></span>
                        </div>
                        <button type="submit" class="btn btn-success">Gửi đánh giá</button>
                    </form>
                </div>
            }
            else if (currentUserId != null && hasUserReviewed)
            {
                <div class="alert alert-info mt-4" role="alert">
                    Bạn đã gửi đánh giá cho địa điểm này rồi.
                </div>
            }
            else
            {
                <div class="alert alert-info mt-4" role="alert">
                    Vui lòng <a asp-controller="Account" asp-action="Login">đăng nhập</a> để gửi đánh giá.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // JavaScript cho việc tự động biến mất thông báo (giữ nguyên)
            const successAlert = document.getElementById('successAlert');
            const errorAlert = document.getElementById('errorAlert');

            function hideAlert(alertElement, delay = 5000) {
                if (alertElement) {
                    setTimeout(() => {
                        if (alertElement && alertElement.classList.contains('show')) {
                            const bsAlert = bootstrap.Alert.getInstance(alertElement) || new bootstrap.Alert(alertElement);
                            bsAlert.close();
                        } else if (alertElement) {
                            alertElement.style.display = 'none';
                        }
                    }, delay);
                }
            }

            if (successAlert) {
                hideAlert(successAlert, 5000);
            }
            if (errorAlert) {
                hideAlert(errorAlert, 7000);
            }

            // =============================================================
            // BẮT ĐẦU PHẦN JAVASCRIPT MỚI CHO ĐÁNH GIÁ SAO
            // =============================================================
            const starRatingContainer = document.getElementById('starRating');
            const stars = starRatingContainer ? starRatingContainer.querySelectorAll('i') : [];
            const hiddenRatingInput = document.getElementById('Rating'); // Input hidden
            const ratingValidationMessage = document.getElementById('ratingValidationMessage');
            const reviewForm = document.querySelector('form[asp-action="AddReview"]');
            const commentTextarea = document.getElementById('Comment');
            const commentValidationMessage = document.getElementById('commentValidationMessage');

            let currentRating = 0; // Biến lưu trữ số sao hiện tại đã chọn

            if (starRatingContainer && stars.length > 0 && hiddenRatingInput) {
                stars.forEach(star => {
                    star.addEventListener('click', function () {
                        const rating = parseInt(this.dataset.rating);
                        currentRating = rating;
                        hiddenRatingInput.value = rating; // Cập nhật giá trị vào input hidden
                        updateStarDisplay(rating);
                        ratingValidationMessage.textContent = ''; // Xóa thông báo lỗi khi chọn
                    });

                    star.addEventListener('mouseover', function () {
                        if (currentRating === 0) { // Chỉ hover khi chưa chọn sao nào
                            const hoverRating = parseInt(this.dataset.rating);
                            updateStarDisplay(hoverRating, true);
                        }
                    });

                    star.addEventListener('mouseout', function () {
                        if (currentRating === 0) { // Chỉ bỏ hover khi chưa chọn sao nào
                            updateStarDisplay(0); // Đặt lại về trạng thái không có sao nào được hover
                        }
                    });
                });

                // Hàm cập nhật trạng thái hiển thị của các ngôi sao
                function updateStarDisplay(ratingValue, isHover = false) {
                    stars.forEach(star => {
                        const starNum = parseInt(star.dataset.rating);
                        if (isHover) {
                            if (starNum <= ratingValue) {
                                star.classList.add('fas', 'hover'); // Đầy và có hiệu ứng hover
                                star.classList.remove('far', 'selected');
                            } else {
                                star.classList.add('far'); // Rỗng
                                star.classList.remove('fas', 'hover', 'selected');
                            }
                        } else {
                            if (starNum <= ratingValue) {
                                star.classList.add('fas', 'selected'); // Đầy và đã chọn
                                star.classList.remove('far', 'hover');
                            } else {
                                star.classList.add('far'); // Rỗng
                                star.classList.remove('fas', 'hover', 'selected');
                            }
                        }
                    });
                }
            }

            // =============================================================
            // KẾT THÚC PHẦN JAVASCRIPT MỚI CHO ĐÁNH GIÁ SAO
            // =============================================================


            // JavaScript cho form đánh giá (cần điều chỉnh validation)
            if (reviewForm) {
                reviewForm.addEventListener('submit', function (event) {
                    ratingValidationMessage.textContent = '';
                    commentValidationMessage.textContent = '';

                    let isValid = true;
                    // Lấy giá trị từ input hidden thay vì select
                    const ratingValue = hiddenRatingInput.value;
                    const commentValue = commentTextarea.value;

                    if (ratingValue === "" || parseInt(ratingValue) === 0) {
                        ratingValidationMessage.textContent = 'Vui lòng chọn số sao đánh giá.';
                        isValid = false;
                    }

                    if (commentValue.length > 2000) {
                        commentValidationMessage.textContent = 'Bình luận không được vượt quá 2000 ký tự.';
                        isValid = false;
                    }

                    if (!isValid) {
                        event.preventDefault();
                    }
                });
            }
        });
    </script>
}
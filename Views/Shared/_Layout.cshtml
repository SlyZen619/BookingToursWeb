<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookingToursWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookingToursWeb.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />

    <style>
        /* Tùy chỉnh Navbar */
        .navbar-custom {
            background-color: #007bff; /* Màu xanh dương chủ đạo */
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
        }

            .navbar-custom .navbar-brand,
            .navbar-custom .nav-link {
                color: #ffffff; /* Chữ trắng */
                transition: color 0.3s ease;
            }

                .navbar-custom .navbar-brand:hover,
                .navbar-custom .nav-link:hover {
                    color: #e0e0e0; /* Chữ hơi xám khi hover */
                }

            .navbar-custom .navbar-toggler {
                border-color: rgba(255,255,255,.1);
            }

            .navbar-custom .navbar-toggler-icon {
                background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 0.55%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
            }

            .navbar-custom .nav-link.dropdown-toggle::after {
                content: none; /* Loại bỏ nội dung mặc định (là mũi tên) */
            }

        /* Tùy chỉnh nút Admin */
        .btn-admin-nav {
            font-size: 0.85rem; /* Kích thước chữ nhỏ hơn */
            padding: 0.3rem 0.7rem; /* Giảm padding */
            border-radius: 0.3rem; /* Bo tròn nhẹ */
            margin-left: 15px; /* Khoảng cách với các mục khác */
        }

            .btn-admin-nav.btn-outline-light {
                color: #ffffff;
                border-color: #ffffff;
            }

                .btn-admin-nav.btn-outline-light:hover {
                    background-color: #ffffff;
                    color: #007bff;
                }

        /* Main Content Styling */
        main {
            padding-top: 20px;
            padding-bottom: 20px;
            /* Đảm bảo main có thể mở rộng để đẩy footer xuống */
            flex-grow: 1; /* Rất quan trọng cho flexbox sticky footer */
        }

        /* Footer Styling (chỉ giữ lại những phần không liên quan đến position) */
        footer {
            /* Các thuộc tính position, bottom, left, z-index sẽ bị loại bỏ */
            background-color: #f8f9fa; /* Màu nền nhẹ cho footer */
            padding: 15px 0;
            font-size: 0.9em;
            color: #6c757d;
        }

            footer a {
                color: #007bff;
                text-decoration: none;
            }

                footer a:hover {
                    text-decoration: underline;
                }
        /* Style cho các mục trong dropdown nếu cần */
        .dropdown-item {
            color: #343a40; /* Màu chữ mặc định */
        }

            .dropdown-item:hover {
                background-color: #f8f9fa; /* Nền nhẹ khi hover */
                color: #007bff; /* Màu chữ khi hover */
            }

        .btn-admin-nav-dropdown, /* Áp dụng style chung cho các nút panel */
        .btn-location-manager-nav-dropdown {
            color: #007bff; /* Màu chữ xanh cho nút admin/manager trong dropdown */
            font-weight: bold;
        }

            .btn-admin-nav-dropdown:hover,
            .btn-location-manager-nav-dropdown:hover {
                background-color: #e6f2ff; /* Nền xanh nhạt khi hover */
            }

        /* CSS MỚI ĐỂ TẠO STICKY FOOTER */
        html, body {
            height: 100%; /* Đảm bảo html và body chiếm toàn bộ chiều cao viewport */
        }

        #root-container {
            display: flex;
            flex-direction: column;
            min-height: 100vh; /* Đảm bảo container này chiếm ít nhất toàn bộ chiều cao viewport */
        }

    </style>
</head>
<body>
    <div id="root-container">
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-custom border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BookingToursWeb</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Booking">Đặt lịch</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="postsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Bài viết
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="postsDropdown">
                                    @await Html.PartialAsync("_CategoryDropdownPartial")
                                </ul>
                            </li>
                        </ul>
                        <ul class="navbar-nav">
                            @* Kiểm tra xem người dùng đã đăng nhập chưa bằng Session *@
                            @if (Context.Session.GetInt32("UserId") != null)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Xin chào, @Context.Session.GetString("Username")! @* Hiển thị tên người dùng đã đăng nhập *@
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Home" asp-action="Profile">Profile của tôi</a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li> @* Đường phân cách *@

                                        @* Nút Admin Panel - chỉ hiển thị nếu là Admin *@
                                        @if (Context.Session.GetString("IsAdmin") == "True")
                                        {
                                            <li>
                                                <a class="dropdown-item btn-admin-nav-dropdown" asp-area="" asp-controller="Admin" asp-action="Index">Admin Panel</a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
         @* Đường phân cách *@
                                        }
                                        @* Nút Location Manager Panel - chỉ hiển thị nếu là LocationManager VÀ KHÔNG PHẢI ADMIN *@
                                        @if (Context.Session.GetString("IsLocationManager") == "True" && Context.Session.GetString("IsAdmin") != "True")
                                        {
                                            <li>
                                                <a class="dropdown-item btn-location-manager-nav-dropdown" asp-area="" asp-controller="LocationManager" asp-action="Index">Giao diện quản lý địa điểm</a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
         @* Đường phân cách *@
                                        }

                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                @* CÁC LIÊN KẾT ĐĂNG NHẬP / ĐĂNG KÝ NẾU CHƯA ĐĂNG NHẬP *@
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Account" asp-action="Register">Đăng ký</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <partial name="_FooterPartial" />
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
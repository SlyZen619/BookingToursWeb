@model IEnumerable<BookingToursWeb.Models.Category>
@{
    ViewData["Title"] = "Quản Lý Danh Mục Bài Đăng";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml"; // Đảm bảo đúng layout admin của bạn
}

<div class="container-fluid">
    <h1 class="mt-4">Quản Lý Danh Mục Bài Đăng</h1>
    <p>Đây là trang quản lý các danh mục cho bài đăng trên website.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <p>
        <a asp-action="AddCategory" class="btn btn-primary">Thêm Danh Mục Mới</a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered mt-3">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.Id</td>
                            <td>@category.Name</td>
                            <td>
                                <a asp-action="EditCategory" asp-route-id="@category.Id" class="btn btn-warning btn-sm me-2">Sửa</a>
                                <form asp-action="DeleteCategory" asp-route-id="@category.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                </form>
                                @* Nút "Quản lý bài đăng" sẽ được thêm ở bước tiếp theo *@
                                @* <a asp-action="ListPostsByCategory" asp-route-categoryId="@category.Id" class="btn btn-info btn-sm ms-2">Quản lý bài đăng</a> *@
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3">Chưa có danh mục nào được tạo.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Script để tự động ẩn các alert sau một thời gian
        document.addEventListener('DOMContentLoaded', function () {
            // Chúng ta không cần lấy alert bằng ID nếu đã dùng querySelector chung
            // const successAlert = document.getElementById('successAlert');
            // const errorAlert = document.getElementById('errorAlert');

            function hideAlert(alertElement, delay = 5000) {
                if (alertElement) {
                    setTimeout(() => {
                        // Kiểm tra xem alert có class 'show' để đảm bảo nó đang hiển thị
                        if (alertElement && alertElement.classList.contains('show')) {
                            // Cách 1: Kích hoạt sự kiện click trên nút đóng (phổ biến và đáng tin cậy)
                            const closeButton = alertElement.querySelector('.btn-close');
                            if (closeButton) {
                                closeButton.click(); // Kích hoạt click vào nút đóng
                            } else {
                                // Fallback nếu không tìm thấy nút đóng (ít khi xảy ra với markup chuẩn Bootstrap)
                                // Thêm class 'fade' và 'show' trước khi remove để đảm bảo hiệu ứng
                                alertElement.classList.remove('show');
                                alertElement.classList.add('fade'); // Đảm bảo hiệu ứng fade out
                                setTimeout(() => {
                                    alertElement.remove(); // Loại bỏ phần tử khỏi DOM sau khi fade
                                }, 200); // Thời gian cho hiệu ứng fade kết thúc
                            }
                        }
                    }, delay);
                }
            }

            // Gợi hàm cho alert thành công (5 giây)
            hideAlert(document.querySelector('.alert-success'), 5000);
            // Gợi hàm cho alert lỗi (7 giây)
            hideAlert(document.querySelector('.alert-danger'), 7000);
        });
    </script>
}
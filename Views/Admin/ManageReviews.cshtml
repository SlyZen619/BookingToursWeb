@model IEnumerable<BookingToursWeb.Models.Location> // Đặt Model cho View này là IEnumerable<Location>

@{
    ViewData["Title"] = "Quản lý Đánh giá theo Địa điểm"; // Cập nhật tiêu đề View
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml"; // Đảm bảo đúng layout admin
}

    <h2 class="mt-4">@ViewData["Title"]</h2>
    <p>Chọn một địa điểm để xem và quản lý các đánh giá của nó.</p>

@if (TempData["ErrorMessage"] != null)
{
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
}

    <table class="table table-striped table-bordered mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên Địa điểm</th>
                <th>Địa chỉ</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any()) // Kiểm tra nếu có dữ liệu địa điểm
            {
                @foreach (var location in Model)
                {
                    <tr>
                        <td>@location.Id</td>
                        <td>@location.Name</td>
                        <td>@location.Address</td>
                        <td>
                            @* Nút để chuyển đến trang ListReviewsForLocation của địa điểm này *@
                            <a asp-controller="Admin" asp-action="ListReviewsForLocation" asp-route-locationId="@location.Id" class="btn btn-info btn-sm">Quản lý Đánh giá</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4">Chưa có địa điểm nào trong hệ thống.</td>
                </tr>
            }
        </tbody>
    </table>

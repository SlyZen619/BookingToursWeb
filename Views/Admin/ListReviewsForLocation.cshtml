@model IEnumerable<BookingToursWeb.Models.Review>

@{
    ViewData["Title"] = $"Đánh giá cho: {ViewBag.LocationName}";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

<h2 class="mt-4">@ViewData["Title"]</h2>

<p class="mt-3">
    <a asp-controller="Admin" asp-action="ManageReviews" class="btn btn-secondary">Quay lại Quản lý Đánh giá theo Địa điểm</a>
</p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger fade show" role="alert" id="errorAlert">
        @TempData["ErrorMessage"]
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success fade show" role="alert" id="successAlert">
        @TempData["SuccessMessage"]
    </div>
}

<table class="table table-striped table-bordered mt-3">
    <thead>
        <tr>
            <th>ID</th>
            <th>Người dùng</th>
            <th>Điểm đánh giá</th>
            <th>Nhận xét</th>
            <th>Ngày tạo</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var review in Model)
            {
                <tr>
                    <td>@review.Id</td>
                    <td>@review.User?.Username</td>
                    <td>@review.Rating</td>
                    <td>@(string.IsNullOrEmpty(review.Comment) ? "Không có" : review.Comment)</td>
                    <td>@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <form asp-action="DeleteReview" asp-controller="Admin" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đánh giá này không?');" style="display:inline;">
                            <input type="hidden" name="id" value="@review.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                            @Html.AntiForgeryToken()
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6">Địa điểm này chưa có đánh giá nào.</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const successAlert = document.getElementById('successAlert');
            const errorAlert = document.getElementById('errorAlert');

            function hideAlert(alertElement, delay = 5000) {
                if (alertElement) {
                    setTimeout(() => {
                        // Kiểm tra xem phần tử vẫn còn trong DOM và có lớp 'show' không
                        // 'show' có thể đã bị xóa bởi người dùng nhấn nút đóng (nếu có)
                        if (alertElement && alertElement.classList.contains('show')) {
                            // Lấy instance hoặc tạo mới nếu chưa có.
                            // Điều này quan trọng vì alert có thể đã được bootstrap tự động khởi tạo.
                            const bsAlert = bootstrap.Alert.getInstance(alertElement) || new bootstrap.Alert(alertElement);

                            // Gọi close(). Phương thức này sẽ kích hoạt hiệu ứng fade-out
                            // và sau đó loại bỏ phần tử khỏi DOM, giải phóng không gian.
                            bsAlert.close();
                        } else if (alertElement) {
                            // Nếu alert không còn lớp 'show' (ví dụ: đã bị đóng thủ công),
                            // nhưng vẫn còn trong DOM, chúng ta có thể ẩn nó đi.
                            // Mặc dù close() là lý tưởng, nhưng nếu nó đã bị đóng,
                            // thì display: none; sẽ là lựa chọn an toàn để loại bỏ khoảng trống.
                            alertElement.style.display = 'none';
                        }
                    }, delay);
                }
            }

            // Gọi hàm cho alert thành công (5 giây)
            hideAlert(successAlert, 5000);
            // Gọi hàm cho alert lỗi (7 giây)
            hideAlert(errorAlert, 7000);
        });
    </script>
}
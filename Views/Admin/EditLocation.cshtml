@model BookingToursWeb.Models.Location

@{
    ViewData["Title"] = "Sửa thông tin Địa điểm";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="EditLocation" method="post">
            @* THÊM method="post" *@
            @Html.AntiForgeryToken() @* Rất quan trọng cho form POST, ngăn CSRF *@

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" /> @* Quan trọng: Giữ Id của địa điểm *@
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Information" class="form-label"></label>
                <textarea asp-for="Information" class="form-control" rows="10"></textarea>
                <span asp-validation-for="Information" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TicketPrice" class="form-label"></label>
                <input asp-for="TicketPrice" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="TicketPrice" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="OpeningHours" class="form-label"></label>
                <input asp-for="OpeningHours" class="form-control" />
                <span asp-validation-for="OpeningHours" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ContactInfo" class="form-label"></label>
                <input asp-for="ContactInfo" class="form-control" />
                <span asp-validation-for="ContactInfo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Latitude" class="form-label"></label>
                <input asp-for="Latitude" class="form-control" type="number" step="any" /> @* step="any" cho phép số thập phân *@
                <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Longitude" class="form-label"></label>
                <input asp-for="Longitude" class="form-control" type="number" step="any" /> @* step="any" cho phép số thập phân *@
                <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" asp-for="IsActive" />
                <label class="form-check-label" asp-for="IsActive"></label>
            </div>

            <h4 class="mt-4">Thông tin Thanh toán</h4>
            <div class="mb-3">
                <label asp-for="BankName" class="form-label"></label>
                <input asp-for="BankName" class="form-control" />
                <span asp-validation-for="BankName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BankAccountNumber" class="form-label"></label>
                <input asp-for="BankAccountNumber" class="form-control" />
                <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BankAccountName" class="form-label"></label>
                <input asp-for="BankAccountName" class="form-control" />
                <span asp-validation-for="BankAccountName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PaymentInstructions" class="form-label"></label>
                <textarea asp-for="PaymentInstructions" class="form-control" rows="3"></textarea>
                <span asp-validation-for="PaymentInstructions" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="ManagerUserId" class="form-label">Người quản lý</label>
                <select name="ManagerUserId" id="ManagerUserId" class="form-control"
                        asp-items="@(new SelectList(ViewBag.PotentialManagers, "Value", "Text", ViewBag.SelectedManagerId))">
                </select>
                @* Hiển thị lỗi từ Controller nếu có *@
                @if (ViewData.ModelState.TryGetValue("ManagerUserId", out var modelStateEntry) && modelStateEntry != null && modelStateEntry.Errors.Any())
                {
                    <span class="text-danger">@modelStateEntry.Errors.First().ErrorMessage</span>
                }
            </div>
            <div class="mb-3">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                <a asp-action="ManageLocations" class="btn btn-secondary">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
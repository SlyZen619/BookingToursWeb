@* Thay đổi dòng này: *@
@* @model BookingToursWeb.Models.ViewModels.PostManagementViewModel *@

@* Thành dòng này: *@
@model BookingToursWeb.Models.PostManagementViewModel

@{
    ViewData["Title"] = "Quản Lý Bài Đăng";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml"; // Đảm bảo đúng layout admin của bạn
}

<div class="container-fluid">
    <h1 class="mt-4">Quản Lý Bài Đăng</h1>
    <p>Đây là trang quản lý các bài đăng trên website, được nhóm theo danh mục.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <p>
        <a asp-action="AddPost" class="btn btn-primary">Thêm Bài Đăng Mới</a>
    </p>

    @if (Model != null && Model.CategoriesWithPosts != null && Model.CategoriesWithPosts.Any())
    {
        @foreach (var categoryGroup in Model.CategoriesWithPosts.OrderBy(c => c.CategoryName)) @* Sắp xếp theo tên danh mục *@
        {
            <h3 class="mt-4 mb-3">Danh Mục: @categoryGroup.CategoryName (@categoryGroup.Posts.Count() bài đăng)</h3>
            <div class="table-responsive mb-5">
                @* Thêm margin-bottom để phân biệt các bảng *@
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>ID Bài Đăng</th>
                            <th>Tiêu Đề</th>
                            <th>Tác giả</th>
                            <th>Ngày Xuất Bản</th>
                            <th>Cập Nhật Lần Cuối</th>
                            <th>Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (categoryGroup.Posts.Any())
                        {
                            @foreach (var post in categoryGroup.Posts)
                            {
                                <tr>
                                    <td>@post.Id</td>
                                    <td>@post.Title</td>
                                    <td>@post.Author?.Username</td>
                                    <td>@post.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@post.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <a asp-action="EditPost" asp-route-id="@post.Id" class="btn btn-warning btn-sm me-2">Sửa</a>
                                        <form asp-action="DeletePost" asp-route-id="@post.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài đăng này?');">
                                            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">Chưa có bài đăng nào trong danh mục "@categoryGroup.CategoryName".</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info mt-3" role="alert">
            Chưa có danh mục hoặc bài đăng nào được tạo.
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function hideAlert(alertElement, delay = 5000) {
                if (alertElement) {
                    setTimeout(() => {
                        if (alertElement && alertElement.classList.contains('show')) {
                            const closeButton = alertElement.querySelector('.btn-close');
                            if (closeButton) {
                                closeButton.click();
                            } else {
                                alertElement.classList.remove('show');
                                alertElement.classList.add('fade');
                                setTimeout(() => {
                                    alertElement.remove();
                                }, 200);
                            }
                        }
                    }, delay);
                }
            }

            hideAlert(document.querySelector('.alert-success'), 5000);
            hideAlert(document.querySelector('.alert-danger'), 7000);
        });
    </script>
}
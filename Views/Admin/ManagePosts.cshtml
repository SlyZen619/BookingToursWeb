@model BookingToursWeb.Models.PostManagementViewModel

@{
    ViewData["Title"] = "Quản Lý Bài Đăng";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml"; // Đảm bảo đúng layout admin của bạn
}

<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">@ViewData["Title"]</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-action="AddPost" class="btn btn-primary me-2">
            <span data-feather="plus-circle"></span>
        </a>
        <a asp-action="ManageCategories" asp-controller="Admin" class="btn btn-secondary">
            <span data-feather="grid"></span> Quản lý Danh mục
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách Bài đăng theo Danh mục</h6>
    </div>
    <div class="card-body">
        @if (Model != null && Model.CategoriesWithPosts != null && Model.CategoriesWithPosts.Any())
        {
            @foreach (var categoryGroup in Model.CategoriesWithPosts.OrderBy(c => c.CategoryName))
            {
                <h3 class="mt-4 mb-3">Danh Mục: @categoryGroup.CategoryName (@categoryGroup.Posts.Count() bài đăng)</h3>
                <div class="table-responsive mb-5">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Tiêu Đề</th>
                                <th>Tác giả</th>
                                <th>Ngày Xuất Bản</th>
                                <th>Cập Nhật Lần Cuối</th>
                                <th>Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (categoryGroup.Posts.Any())
                            {
                                @foreach (var post in categoryGroup.Posts)
                                {
                                    <tr>
                                        <td>@post.Title</td>
                                        <td>@post.Author?.Username</td>
                                        <td>@post.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@post.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <a asp-action="EditPost" asp-route-id="@post.Id" class="btn btn-info btn-sm">Sửa</a>
                                            <form asp-action="DeletePost" asp-route-id="@post.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài đăng này?');">
                                                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6">Chưa có bài đăng nào trong danh mục "@categoryGroup.CategoryName".</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info mt-3" role="alert">
                Chưa có danh mục hoặc bài đăng nào được tạo.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function hideAlert(alertElement, delay = 5000) {
                if (alertElement) {
                    setTimeout(() => {
                        if (alertElement && alertElement.classList.contains('show')) {
                            const closeButton = alertElement.querySelector('.btn-close');
                            if (closeButton) {
                                closeButton.click();
                            } else {
                                alertElement.classList.remove('show');
                                alertElement.classList.add('fade');
                                setTimeout(() => {
                                    alertElement.remove();
                                }, 200);
                            }
                        }
                    }, delay);
                }
            }

            hideAlert(document.querySelector('.alert-success'), 5000);
            hideAlert(document.querySelector('.alert-danger'), 7000);

            // Khởi tạo Feather Icons
            if (typeof feather !== 'undefined') {
                feather.replace();
            }
        });
    </script>
}